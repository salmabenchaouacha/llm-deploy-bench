# Copy to .env and fill in. .env is git-ignored: never commit real secrets.

# Hugging Face: needed for gated models (Llama 3.2) and faster downloads.
# https://huggingface.co/settings/tokens  (read access is enough)
HF_TOKEN=

# Where downloaded weights are cached (keep it outside the repo, it grows to tens of GB).
HF_HOME=~/.cache/huggingface

# Weights & Biases: fine-tuning experiment tracking (Phase 5).
WANDB_API_KEY=

# LLM API used as RAGAS judge (Phase 3) and few-shot baseline (Phase 5).
GEMINI_API_KEY=
GROQ_API_KEY=

# Served model (`make serve-up`). Path relative to ~/.cache/llmbench/models.
# LLM_GGUF=bartowski__Llama-3.2-3B-Instruct-GGUF/Llama-3.2-3B-Instruct-Q4_K_M.gguf
# LLM_ALIAS=llama3.2-3b-q4_k_m
# LLM_PARALLEL=4
# LLM_CTX=12288

# Logging
LLMBENCH_LOG_LEVEL=INFO
LLMBENCH_LOG_JSON=0
